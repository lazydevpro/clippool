# ClipPool — environment variables
# Copy to `.env` (never commit `.env`). One root file is shared by contracts/, packages/, and apps/web/.
# Legend:  [T] needed for testnet end-to-end   [M] needed for mainnet launch   [P] public (safe in browser)

# ── Network ──────────────────────────────────────────────────────────────────
# arcTestnet (5042002) for development, arc (5042) for production
NEXT_PUBLIC_CHAIN=arcTestnet                                    # [P]
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io                  # [T] public endpoint works; swap for Alchemy/QuickNode if rate-limited
ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io                  # [M]
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.io              # [P] RPC used by the browser for the selected chain

# ── Contract (filled in after deploy) ────────────────────────────────────────
NEXT_PUBLIC_CLIPPOOL_ADDRESS=                                   # [P] set by deploy script
NEXT_PUBLIC_CLIPPOOL_DEPLOY_BLOCK=                              # [P] start block for event indexing

# ── Operator wallets (use DIFFERENT keys for testnet and mainnet) ─────────────
# Each needs a little USDC on Arc for gas (testnet: faucet.circle.com).
DEPLOYER_PRIVATE_KEY=                                           # [T][M] contract owner; deploys + configures
ORACLE_PRIVATE_KEY=                                             # [T][M] posts allocation roots (~$0.01/campaign gas)
KEEPER_PRIVATE_KEY=                                             # [T][M] pushes payouts via claimMany (~$0.002/creator gas)
GUARDIAN_ADDRESS=                                               # [T][M] YOUR personal wallet address (no key) — can cancel a bad root
# Optional deploy overrides (seconds; testnet/anvil only — mainnet always uses 48h / 1h, the script refuses overrides):
# DISPUTE_WINDOW_SECONDS=600                                    # default testnet 600 (10 min), anvil 600
# MIN_MEASUREMENT_DELAY_SECONDS=300                             # default testnet 300 (5 min), anvil 60

# ── Testnet E2E only ─────────────────────────────────────────────────────────
TEST_BRAND_PRIVATE_KEY=                                         # [T] throwaway testnet wallet funded with ~20 testnet USDC (+ optional EURC)

# ── YouTube Data API v3 ──────────────────────────────────────────────────────
YOUTUBE_API_KEY=                                                # [T][M] Google Cloud → enable "YouTube Data API v3" → API key (restrict to that API)

# ── Database (Neon Postgres) ─────────────────────────────────────────────────
DATABASE_URL=                                                   # [T][M] pooled connection string (…-pooler…/neondb?sslmode=require)
DATABASE_URL_UNPOOLED=                                          # [T][M] direct connection string (for migrations)

# ── Circle user-controlled wallets (creator login) ───────────────────────────
CIRCLE_API_KEY=                                                 # [T] Circle Developer Console → Keys → API key (TEST_API_KEY:… for testnet; LIVE_API_KEY:… later [M])
NEXT_PUBLIC_CIRCLE_APP_ID=                                      # [T][P] Console → Wallets → User Controlled → Configurator → App ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=                                   # [T][P] Google Cloud OAuth client (Web); also entered in Circle Console social-login config
#   Also used by "Connect YouTube" (GIS token popup, scope youtube.readonly): add every app origin under
#   "Authorized JavaScript origins"; the backend checks tokens were minted for this client id.

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000                       # [P] production URL later (OAuth redirect must match)
CRON_SECRET=                                                    # [T][M] random string; auto-generated in local .env
